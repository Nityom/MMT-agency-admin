# Dedicated admin Convex deployment (safe to expose to the browser).
CONVEX_DEPLOYMENT=dev:mild-aardvark-917
NEXT_PUBLIC_CONVEX_URL=https://mild-aardvark-917.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://mild-aardvark-917.convex.site

# Separate mobile/web app deployment. Keep server-only and read-only in admin code.
APP_CONVEX_URL=https://your-app-deployment.convex.cloud

# Admin portal credentials (must use NEXT_PUBLIC_ prefix for client-side access)
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-password
